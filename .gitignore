# =============================================================================
# ReliAgent .gitignore
# Proyecto open-source: Tauri (Rust) + Svelte + Python + Ollama + SQLite
# =============================================================================

# -----------------------------------------------------------------------------
# Secretos y configuración local (NUNCA subir)
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example
*.key
*.pem
*.p12
*.pfx
*.crt
credentials.json
secrets.json
settings.local.json

# -----------------------------------------------------------------------------
# Rust / Cargo (src-tauri/)
# -----------------------------------------------------------------------------
target/
**/*.rs.bk
*.pdb

# Mantener Cargo.lock (es una aplicación binaria, no una librería)
# Si en el futuro extraes crates como librerías, añade su Cargo.lock al ignore.

# -----------------------------------------------------------------------------
# Tauri
# -----------------------------------------------------------------------------
src-tauri/target/
src-tauri/gen/
src-tauri/WixTools/
src-tauri/.cargo/

# -----------------------------------------------------------------------------
# Node.js / Frontend (Svelte)
# -----------------------------------------------------------------------------
node_modules/
dist/
build/
.svelte-kit/
.vite/
.turbo/
.parcel-cache/
*.tsbuildinfo

# Logs de gestores de paquetes
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Bloqueos duplicados — elegir uno según el gestor usado
# (deja solo el lockfile de tu gestor y descomenta los otros)
# package-lock.json
# yarn.lock
# pnpm-lock.yaml

# -----------------------------------------------------------------------------
# Python (python-core/)
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg
*.egg-info/
dist/
build/
wheels/
pip-log.txt
pip-delete-this-directory.txt

# Entornos virtuales
.venv/
venv/
env/
ENV/
.python-version

# Testing y coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
.hypothesis/

# Type checkers / linters
.mypy_cache/
.pyre/
.pytype/
.ruff_cache/
.pyright/

# Jupyter
.ipynb_checkpoints/

# -----------------------------------------------------------------------------
# Datos sensibles del runtime de ReliAgent
# -----------------------------------------------------------------------------
# Base de datos local con el log de acciones (contiene prompts del usuario)
logs.db
logs.db-journal
logs.db-wal
logs.db-shm
*.sqlite
*.sqlite3
*.db

# Directorio sandbox local (donde el agente escribe archivos)
ReliAgent_Sandbox/
sandbox/
**/ReliAgent_Sandbox/

# Configuración de runtime del usuario
.reliagent/
reliagent-config.local.*

# Modelos de LLM (GGUF grandes — nunca commitear)
*.gguf
*.bin
*.safetensors
models/
ollama-models/

# Módulos Wasm compilados
*.wasm
!docs/**/*.wasm

# -----------------------------------------------------------------------------
# Documentación (mdBook)
# -----------------------------------------------------------------------------
docs/book/
book/

# -----------------------------------------------------------------------------
# IDEs y editores
# -----------------------------------------------------------------------------
.vscode/*
!.vscode/settings.json.example
!.vscode/extensions.json
!.vscode/launch.json.example
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace
*.code-workspace
.history/

# -----------------------------------------------------------------------------
# Sistema operativo
# -----------------------------------------------------------------------------
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.Spotlight-V100
.Trashes

# Linux
*~
.fuse_hidden*
.directory
.Trash-*
.nfs*

# -----------------------------------------------------------------------------
# Logs y archivos temporales
# -----------------------------------------------------------------------------
*.log
logs/
tmp/
temp/
*.tmp
*.bak
*.backup
*.old

# -----------------------------------------------------------------------------
# CI / artefactos de release
# -----------------------------------------------------------------------------
release/
releases/
*.msi
*.dmg
*.deb
*.AppImage
*.rpm
*.exe
*.app

# -----------------------------------------------------------------------------
# Claude Code / herramientas locales del autor
